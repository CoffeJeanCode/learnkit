{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LearnKit",
  "version": "0.1.0",
  "identifier": "com.learnkit.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "LearnKit",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2NkExMTE3QTMwMjREQUQKUldTdFRRS2pGeEZxMXRaKytYWlVYcTlaeStqRnE4WUI0aUEycytBY3UxREZFSHVRTWM4eW5kTjMK",
      "endpoints": ["https://github.com/CoffeJeanCode/learnkit/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
